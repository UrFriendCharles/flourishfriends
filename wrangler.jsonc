{
  "name": "flag-quiz",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "flourishfriends.com", "custom_domain": true },
    { "pattern": "www.flourishfriends.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // only these paths hit the worker; everything else is served as static assets
    // (/score/* is intercepted to inject per-score Open Graph preview tags)
    "run_worker_first": ["/api/*", "/ws/*", "/score/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      // 0.5% Club rooms — same room-code space, its own state machine
      { "name": "CLUB_ROOM", "class_name": "ClubRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ClubRoom"] }
  ]
}
